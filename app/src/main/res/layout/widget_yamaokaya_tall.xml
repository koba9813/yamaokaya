<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
        android:textColor="@color/widget_text_secondary" />

    <LinearLayout
        android:id="@+id/widget_shop_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_shop_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:id="@+id/widget_distance_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/zen_maru_gothic_bold"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="@color/widget_accent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_shop_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_shop_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:id="@+id/widget_distance_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/zen_maru_gothic_bold"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/widget_accent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_shop_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_shop_name_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:id="@+id/widget_distance_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/zen_maru_gothic_bold"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/widget_accent" />
    </LinearLayout>
</LinearLayout>
